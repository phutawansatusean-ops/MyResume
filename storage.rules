rules_version = '2';

// NOTE: Storage Security Rules can call firestore.get()/firestore.exists() to check
// Cloud Firestore, but there is no equivalent for Realtime Database — Storage rules
// cannot read the /admins list in RTDB. Profile writes are restricted to the admin
// UID in isPortfolioAdmin(); update it when changing the Admin account.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.uid == 'qYfnzhQ3Uh5l0HkpZfGkDJQ0RW2';
    }

    function isImageUnder5MB() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /projects/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && isImageUnder5MB();
      allow delete: if isSignedIn();
    }

    match /profile/{fileName} {
      allow read: if true;
      allow create, update: if isPortfolioAdmin() && isImageUnder5MB();
      allow delete: if isPortfolioAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
